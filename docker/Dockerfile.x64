FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu20.04

# Set noninteractive mode for apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Preconfigure tzdata
RUN echo "Etc/UTC" > /etc/timezone && \
    ln -fs /usr/share/zoneinfo/Etc/UTC /etc/localtime && \
    apt-get update && apt-get install -y tzdata wget git bzip2 libgeos-dev curl && \
    dpkg-reconfigure --frontend noninteractive tzdata

# 安装 ROS Noetic 和相关依赖
RUN sh -c '. /etc/lsb-release && echo "deb http://mirrors.tuna.tsinghua.edu.cn/ros/ubuntu/ focal main" > /etc/apt/sources.list.d/ros-latest.list' && \
    curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add - && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-noetic-desktop-full \
    ros-noetic-pybind11-catkin \
    ros-noetic-grid-map-core ros-noetic-grid-map-msgs ros-noetic-grid-map-ros ros-noetic-grid-map-rviz-plugin \
    libopencv-dev libeigen3-dev libgmp-dev libmpfr-dev libboost-all-dev \
    ros-noetic-ros-numpy python3-pip python3-osrf-pycommon

# 安装 Miniforge
ENV CONDA_DIR=/opt/conda
RUN wget --quiet https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O ~/miniforge.sh && \
    /bin/bash ~/miniforge.sh -b -p /opt/conda && \
    rm ~/miniforge.sh
ENV PATH=$CONDA_DIR/bin:$PATH

# 使用 conda-forge 源创建环境，直接畅通无阻
RUN conda create -n emc_env python=3.10 -y

# 安装现代深度学习栈
RUN conda run -n emc_env pip install torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128
RUN conda run -n emc_env pip install cupy-cuda12x

# Install other Python packages
COPY requirements.txt /tmp/requirements.txt
RUN conda run -n emc_env pip install -r /tmp/requirements.txt

# 安装 ROS 到 Conda 的桥接库
RUN conda run -n emc_env pip install rospkg pyyaml catkin_pkg

ENV TURTLEBOT3_MODEL=waffle

RUN echo "source /opt/ros/noetic/setup.bash" >> ~/.bashrc && \
    echo "source /opt/conda/etc/profile.d/conda.sh" >> ~/.bashrc && \
    echo "conda activate emc_env" >> ~/.bashrc

